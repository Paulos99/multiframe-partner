# Скопируйте в deploy/.env, заполните и выставьте права: chmod 600 deploy/.env
# Файл НЕ коммитится (.env в .gitignore). Значения генерируйте сами: openssl rand -hex 32

# --- Секреты (обязательно, не короче 32 символов, независимые друг от друга) ---
JWT_SECRET=
ANALYTICS_ADMIN_KEY=
# На время плановой смены JWT_SECRET: сюда старое значение (сессии не рвутся 12 часов)
JWT_SECRET_PREVIOUS=

# --- Хранилище (S3-совместимое) ---
PARTNERS_BUCKET=
# Отдельный бакет для методических материалов (не тот же самый)
MATERIALS_BUCKET=
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# 1 для MinIO и подобных (адресация через путь, а не через поддомен бакета)
S3_FORCE_PATH_STYLE=0

# --- Сайт ---
CORS_ORIGIN=https://stp-multiframe.ru
# Куда слушает входной контейнер на этой машине (внешний прокси с TLS — на этот порт)
WEB_PORT=8081
# Параметры сборки (менять не нужно)
VITE_BASE=/cabinet
VITE_API_URL=/cabinet-api
VITE_DISABLE_DEMO=1

# --- Первый запуск: создаёт ЕДИНСТВЕННОГО администратора в пустом хранилище ---
# После первого входа удалите обе строки и смените пароль в кабинете.
ADMIN_BOOTSTRAP_LOGIN=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=Администратор

# --- Прочее ---
SHARE_LINK_TTL_DAYS=30
# BCRYPT_COST=12
# MAX_BODY_BYTES=6000000
