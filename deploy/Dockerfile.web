# Статика кабинета + nginx. Сайт живёт по адресу /cabinet/, API — по /cabinet-api/ (проксируется на контейнер api).
# Сборка из корня репозитория: docker build -f deploy/Dockerfile.web --build-arg BUILD_ID=v1.0.0 .
FROM node:22-alpine AS build
ARG VITE_BASE=/cabinet
ARG VITE_API_URL=/cabinet-api
ARG VITE_DISABLE_DEMO=1
ARG BUILD_ID=local
ENV VITE_BASE=$VITE_BASE VITE_API_URL=$VITE_API_URL VITE_DISABLE_DEMO=$VITE_DISABLE_DEMO BUILD_ID=$BUILD_ID
WORKDIR /app
COPY apps/web/package.json apps/web/package-lock.json apps/web/
RUN cd apps/web && npm ci --no-audit --no-fund
COPY apps/web apps/web
COPY packages packages
RUN cd apps/web && npx tsc -b && npx vite build

FROM nginx:1.27-alpine
COPY deploy/nginx/cabinet.conf /etc/nginx/conf.d/default.conf
COPY deploy/nginx/security-headers.conf /etc/nginx/security-headers.conf
COPY --from=build /app/apps/web/dist /usr/share/nginx/html/cabinet
EXPOSE 80
