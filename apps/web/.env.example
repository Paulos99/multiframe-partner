# Yandex Metrika counter id (cookie banner appears only when set)
VITE_YM_ID=

# HTTPS endpoint that accepts POST application/json AnalyticsPayload
# See docs/analytics.md for a Google Apps Script / Sheet example
VITE_ANALYTICS_INGEST_URL=

# Адрес API. Относительный путь (/cabinet-api) работает, если API проксируется с того же домена.
# VITE_API_URL=/cabinet-api
# Базовый путь сайта: / (корень) или /cabinet
# VITE_BASE=/cabinet
# 1 — полностью убрать демо-режим (?demo=1) из сборки. Для боевой сборки включайте.
# VITE_DISABLE_DEMO=1
# Номер сборки (попадает в version.json для автообновления). По умолчанию из GITHUB_SHA.
# BUILD_ID=
