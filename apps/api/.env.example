# Данные кабинета: platform-v2.json, analytics-events.json, PDF docs/
# Без значения деплой не подставляет имя бакета.
PARTNERS_BUCKET=

# Методические материалы. Должен отличаться от PARTNERS_BUCKET.
# Без значения загрузка файла отвечает 503 и не пишет в бакет кабинета.
MATERIALS_BUCKET=

YC_ACCESS_KEY_ID=
YC_SECRET_ACCESS_KEY=
YC_REGION=ru-central1

# Необязательно. По умолчанию platform-v2.json и analytics-events.json.
# PLATFORM_KEY=
# ANALYTICS_KEY=
# Required: generate independent random values; never commit them.
JWT_SECRET=
ANALYTICS_ADMIN_KEY=
# Optional during planned rotation:
JWT_SECRET_PREVIOUS=
# Local frontend origin; production defaults to https://paulos99.github.io
CORS_ORIGIN=http://localhost:5173

# --- Хранилище: любое S3-совместимое (по умолчанию Yandex Object Storage) ---
# S3_ENDPOINT=https://storage.yandexcloud.net
# S3_REGION=ru-central1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=0

# --- Первый запуск в пустом хранилище ---
# Создаёт единственного администратора (пароль не короче 10 символов). После входа удалите строки.
# ADMIN_BOOTSTRAP_LOGIN=
# ADMIN_BOOTSTRAP_PASSWORD=
# ADMIN_BOOTSTRAP_NAME=Администратор

# --- Демонстрационные данные ---
# DEMO_SEED=1 включает демо-кабинеты с известными паролями. На боевом сервере НЕ задавайте.
# По умолчанию демо поднимается только без бакета и вне NODE_ENV=production.
# DEMO_SEED=
# ALLOW_DEMO_RESET=1 разрешает сбрасывать данные скриптами seed (только стенд!)
# ALLOW_DEMO_RESET=

# --- Прочее ---
# CORS_ORIGIN принимает список через запятую: https://stp-multiframe.ru,https://paulos99.github.io
# SHARE_LINK_TTL_DAYS=30
# BCRYPT_COST=12
# MAX_BODY_BYTES=6000000
# Автономный сервер (apps/api/server.mjs): PORT=8080 HOST=127.0.0.1 TRUST_PROXY=1
