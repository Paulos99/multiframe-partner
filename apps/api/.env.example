# Данные кабинета: platform-v2.json, analytics-events.json, PDF docs/
# Без значения деплой не подставляет имя бакета.
PARTNERS_BUCKET=

# Методические материалы. Должен отличаться от PARTNERS_BUCKET.
# Без значения загрузка файла отвечает 503 и не пишет в бакет кабинета.
MATERIALS_BUCKET=

YC_ACCESS_KEY_ID=
YC_SECRET_ACCESS_KEY=
YC_REGION=ru-central1

# Необязательно. По умолчанию platform-v2.json и analytics-events.json.
# PLATFORM_KEY=
# ANALYTICS_KEY=
# Required: generate independent random values; never commit them.
JWT_SECRET=
ANALYTICS_ADMIN_KEY=
# Optional during planned rotation:
JWT_SECRET_PREVIOUS=
# Local frontend origin; production defaults to https://paulos99.github.io
CORS_ORIGIN=http://localhost:5173
